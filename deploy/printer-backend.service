[Unit]
Description=GreenPrint Linux CUPS backend
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/orangepi/Code/Printer/Python/WSGI
Environment=PRINTER_CONFIG=/home/orangepi/Code/Printer/Python/WSGI/config.yaml
ExecStart=/home/orangepi/Code/.env/bin/python /home/orangepi/Code/Printer/Python/WSGI/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
